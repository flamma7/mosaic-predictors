+from unittest.mock import MagicMock
+
+import cv2
+import gymnasium as gym
+import numpy as np
+
+from stable_worldmodel.world.world import _apply_configured_visuals
+from stable_worldmodel.wrapper.visual import (
+    DarkWrapper,
+    adajepa_blur_kernel,
+    apply_blur,
+    apply_dark,
+    apply_salt_pepper,
+    make_adajepa_wrappers,
+    make_pusht_color_variations,
+)
+
+
+def _dummy_env():
+    env = MagicMock(spec=gym.Env)
+    env.observation_space = gym.spaces.Box(low=0, high=1, shape=(1,))
+    env.action_space = gym.spaces.Box(low=0, high=1, shape=(1,))
+    return env
+
+
+def test_adajepa_blur_matches_cv2_kernel():
+    assert adajepa_blur_kernel(2.0) == 13
+    frame = np.arange(16 * 16 * 3, dtype=np.uint8).reshape(16, 16, 3)
+    expected = cv2.GaussianBlur(frame, (13, 13), sigmaX=2.0, sigmaY=2.0)
+    assert np.array_equal(apply_blur(frame, 2.0), expected)
+
+
+def test_salt_pepper_writes_equal_salt_and_pepper_counts():
+    frame = np.full((10, 10, 3), 128, dtype=np.uint8)
+    out = apply_salt_pepper(frame, 0.01, np.random.RandomState(0))
+    # n = int(0.01 * 100) = 1, and seed 0 does not collide.
+    assert (out == 255).all(axis=-1).sum() == 1
+    assert (out == 0).all(axis=-1).sum() == 1
+    assert np.all(frame == 128)
+
+
+def test_dark_multiplies_then_truncates_to_uint8():
+    frame = np.full((2, 2, 3), 201, dtype=np.uint8)
+    out = apply_dark(frame, 0.5)
+    assert out.dtype == np.uint8
+    assert np.all(out == 100)
+
+
+def test_dark_wrapper_perturbs_goal_image_and_not_goal_state():
+    wrapped = DarkWrapper(_dummy_env(), factor=0.5)
+    info = {
+        'pixels': np.full((2, 2, 3), 200, dtype=np.uint8),
+        'goal': np.full((2, 2, 3), 200, dtype=np.uint8),
+        'goal_state': np.zeros(7),
+    }
+    out = wrapped._apply_to_info(info)
+    assert np.all(out['pixels'] == 100)
+    assert np.all(out['goal'] == 100)
+    assert np.all(out['goal_state'] == 0)
+
+
+def test_adajepa_wrapper_defaults():
+    assert make_adajepa_wrappers() == []
+    blur = make_adajepa_wrappers(blur=True)[0](_dummy_env())
+    assert blur._kernel == 13
+    assert blur._sigma == 2.0
+    snp = make_adajepa_wrappers(salt_pepper=True, seed=3)[0](_dummy_env())
+    assert snp._density == 0.01
+    snp5 = make_adajepa_wrappers(salt_pepper=0.05, seed=3)[0](_dummy_env())
+    assert snp5._density == 0.05
+    dark = make_adajepa_wrappers(dark=True)[0](_dummy_env())
+    assert dark._factor == 0.5
+
+
+def test_pusht_red_is_pygame_red():
+    red = np.array([255, 0, 0], dtype=np.uint8)
+    values = make_pusht_color_variations(
+        agent_color='Red',
+        block_color=[255, 0, 0],
+        anchor_color='red',
+    )
+    assert np.array_equal(values['agent.color'], red)
+    assert np.array_equal(values['block.color'], red)
+    assert np.array_equal(values['goal.color'], red)
+    assert make_pusht_color_variations() is None
+
+
+def test_dataset_frames_get_the_same_wrapper_as_later_steps():
+    class FrameEnv:
+        transforms_frames = True
+
+        def __init__(self):
+            self.env = None
+            self.calls = 0
+
+        def _apply(self, frame):
+            self.calls += 1
+            return frame + 1
+
+    env = FrameEnv()
+    pixels = np.zeros((2, 2, 3), dtype=np.uint8)
+    goal = np.zeros((2, 2, 3), dtype=np.uint8)
+    init_rows = [{'pixels': pixels, 'state': np.zeros(7)}]
+    goal_rows = [{'goal': goal, 'goal_state': np.ones(7)}]
+
+    _apply_configured_visuals([env], init_rows, goal_rows, rerender=False)
+
+    assert np.all(init_rows[0]['pixels'] == 1)
+    assert np.all(goal_rows[0]['goal'] == 1)
+    assert env.calls == 2
