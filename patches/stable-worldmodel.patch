+            super().__init__()
+            self.calls = []
+
+        def forward(self, emb, act_emb):
+            self.calls.append(emb.detach().clone())
+            return emb
+
+    predictor = _Record()
+    model = LeWM(
+        encoder=_CLSEncoder(visual),
+        predictor=predictor,
