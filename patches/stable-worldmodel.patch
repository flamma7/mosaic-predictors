+def _frame_transforms(env):
+    """``_apply`` callables from frame wrappers, inner wrapper first."""
+    chain = []
+    seen = set()
+    current = env
+    while current is not None and id(current) not in seen:
+        seen.add(id(current))
+        chain.append(current)
+        current = getattr(current, 'env', None)
+    applies = []
+    for wrapper in reversed(chain):
+        if getattr(wrapper, 'transforms_frames', False):
+            applies.append(wrapper._apply)
+    return applies
+
+
+def _has_variation_values(options):
+    if not options:
+        return False
+    if isinstance(options, list):
+        return any(
+            isinstance(item, dict) and item.get('variation_values')
+            for item in options
+        )
+    return bool(options.get('variation_values'))
+
+
+def _with_variation_values(env_options, override):
+    """Copy ``override['variation_values']`` into one env's reset options."""
+    if not override:
+        return env_options
+    merged = dict(env_options or {})
+    extra = override.get('variation_values')
+    if extra:
+        values = dict(merged.get('variation_values') or {})
+        values.update(extra)
+        merged['variation_values'] = values
+    return merged
+
+
+def _render_configured_frame(env, state, goal_pose):
+    render_state = getattr(env.unwrapped, 'render_state', None)
+    if render_state is None or state is None:
+        return None
+    return render_state(state, goal_pose=goal_pose)
+
+
+def _transform_frame(frame, applies):
+    if not isinstance(frame, np.ndarray) or frame.ndim < 3:
+        return frame
+    for apply in applies:
+        frame = apply(frame)
+    return frame
+
+
+def _apply_configured_visuals(envs, init_rows, goal_rows, rerender):
+    """Perturb the dataset frames that bypass ``env.step``.
+
+    Later steps already run the frame wrappers. This covers the initial
+    observation and the goal image, which are injected from the dataset.
+    Color variations are drawn by ``render_state`` before those wrappers.
+    """
+    if not init_rows:
+        return
+    for i, env in enumerate(envs):
+        applies = _frame_transforms(env)
+        if not applies and not rerender:
+            continue
+        goal_pose = init_rows[i].get('goal_pose')
+        if rerender:
+            rendered = _render_configured_frame(
+                env, init_rows[i].get('state'), goal_pose
+            )
+            if rendered is not None:
+                init_rows[i]['pixels'] = rendered
+            rendered_goal = _render_configured_frame(
+                env, goal_rows[i].get('goal_state'), goal_pose
+            )
+            if rendered_goal is not None:
+                goal_rows[i]['goal'] = rendered_goal
+        if applies:
+            if 'pixels' in init_rows[i]:
+                init_rows[i]['pixels'] = _transform_frame(
+                    init_rows[i]['pixels'], applies
+                )
+            if 'goal' in goal_rows[i]:
+                goal_rows[i]['goal'] = _transform_frame(
+                    goal_rows[i]['goal'], applies
+                )
+
+
