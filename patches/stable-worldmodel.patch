+class _CLSEncoder(nn.Module):
+    """Map a clip to a CLS token of ``dim`` so encode can run without a ViT."""
+
+    def __init__(self, dim):
+        super().__init__()
+        self.dim = dim
+        self.bias = nn.Parameter(torch.arange(dim, dtype=torch.float32))
+
+    def forward(self, pixels, interpolate_pos_encoding=True):
+        batch = pixels.shape[0]
+        cls = self.bias.expand(batch, self.dim).unsqueeze(1)
+        return type('Out', (), {'last_hidden_state': cls})()
+
+
+def test_encode_concatenates_proprio_onto_the_cls_latent():
+    """Proprio is one vector per frame, concatenated once onto the CLS token."""
+    torch.manual_seed(0)
+    visual = 4
+    proprio_dim = 3
+    model = LeWM(
+        encoder=_CLSEncoder(visual),
+        predictor=nn.Identity(),
+        action_encoder=nn.Identity(),
+        proprio_encoder=nn.Identity(),
+    )
+    proprio = torch.randn(2, 5, proprio_dim)
+    info = model.encode(
+        {
+            'pixels': torch.randn(2, 5, 3, 8, 8),
+            'proprio': proprio.clone(),
+            'action': torch.randn(2, 5, 2),
+        }
+    )
+    assert info['emb'].shape == (2, 5, visual + proprio_dim)
+    torch.testing.assert_close(info['emb'][..., visual:], proprio)
+
+
