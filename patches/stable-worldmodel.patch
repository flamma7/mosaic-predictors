+            pa.table(
+                {
+                    'episode_idx': np.full(4, episode, dtype=np.int32),
+                    'step_idx': np.arange(4, dtype=np.int32),
+                    'mark': np.full(4, episode, dtype=np.float32),
+                }
+            )
+        )
+    db = lancedb.connect(str(tmp_path))
+    table = db.create_table('strided', schema=tables[0].schema)
+    table.add(pa.concat_tables(tables), write_parallelism=4)
+
+    ds = LanceDataset(path=out, num_steps=4)
+    assert ds.lengths.tolist() == [4] * 12
+    # Fragments are not laid out in episode order.
+    assert (np.diff(ds.offsets) < 0).any()
+    # One clip per episode. Clip i is episode i, and `mark` is that id.
+    for episode in (0, 1, 7, 11):
+        mark = ds[episode]['mark'].numpy()
+        assert mark.shape == (4,)
+        assert np.all(mark == episode)
+
+    split = pa.concat_tables([tables[0], tables[1], tables[0]])
+    bad = lancedb.connect(str(tmp_path / 'splitdb'))
+    bad_table = bad.create_table('split', schema=split.schema)
+    bad_table.add(split, write_parallelism=1)
+    with pytest.raises(ValueError, match='not episode-contiguous'):
+        LanceDataset(path=tmp_path / 'splitdb' / 'split.lance')
+
