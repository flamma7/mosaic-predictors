+def test_parallel_append_is_read_in_episode_order(tmp_path):
+    """LanceDB's parallel add round-robins row groups across fragments.
+
+    Episodes stay contiguous, but a scan sees episode_idx decrease. The
+    reader puts those runs back in episode_idx order.
